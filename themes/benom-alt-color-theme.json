  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7B7B7B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.escape",
        "string.regexp",
        "punctuation.definition.string"
