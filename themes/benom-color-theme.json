  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#797979",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.escape",
        "string.regexp",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#F8F7F2"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#AAAAAA"
      }
    },
    {
